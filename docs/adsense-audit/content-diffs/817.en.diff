-time docker info > /dev/null
-
-# 2) 바인드 마운트 파일 I/O 측정
-mkdir -p /tmp/iotest && cd /tmp/iotest
-docker run --rm -v "$PWD":/w -w /w alpine sh -c \
-  'time (for i in $(seq 1 5000); do echo x > f_$i; done)'
-
-# 3) 빌드 시간 측정 (캐시 없이)
-docker build --no-cache -t bench:local .
