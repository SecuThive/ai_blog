NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
BLOG_API_KEY=your-secret-api-key

# 대표(canonical) 도메인. 실제 서비스 중인 프로덕션 호스트와 반드시 일치시킬 것 —
# metadata base·canonical·OG·sitemap·robots·RSS·JSON-LD가 모두 이 값을 기준으로 생성된다.
# (Vercel Preview/개발 환경에서는 비워두면 코드 기본값으로 폴백 — docs/SEO_ANALYTICS.md 참고)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
# Manual blog ad units: all remain empty until account approval and unit creation.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
# NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID2=

# Issued, tested affiliate tracking URLs only. Leave blank to hide the box.
# AFFILIATE_URL_INFLEARN=
# AFFILIATE_URL_CAFE24=
# AFFILIATE_URL_CLOUDWAYS=
# AFFILIATE_URL_HOSTINGER=
# AFFILIATE_URL_MAKE=

# 자체 호스팅 IndexNow 예약 작업과 수동 제출 API. 각 값은 별도 32바이트 이상 난수로 설정.
# CRON_SECRET=...
# INDEXNOW_SECRET=...

# 뉴스레터의 기존 구독 해지 링크를 유지하려면 이전 배포에서 사용한 값을 그대로 옮긴다.
# UNSUBSCRIBE_TOKEN_SECRET=...

# 네이버 서치어드바이저 "HTML 태그" 소유 확인 코드. 콤마로 여러 개(PC/모바일 속성 등) 지정 가능.
# 값 자체는 페이지 소스에 공개되지만 배포(계정)마다 달라지므로 코드에 고정하지 않는다.
# 미설정 시 <meta name="naver-site-verification"> 태그를 아예 출력하지 않는다.
# NAVER_SITE_VERIFICATION=code1,code2

# 관리자 로그인 (서버 전용). node scripts/setup-admin.mjs your-email@example.com
# ADMIN_USERS_JSON='[{"email":"admin@example.com","passwordHash":"scrypt:<salt>:<hash>"}]'
# ADMIN_SESSION_SECRET=<32자 이상의 암호학적 난수>

# 문의 폼 알림 (선택). RESEND_API_KEY가 없으면 문의는 저장만 되고 알림은 보내지 않는다.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
