NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
BLOG_API_KEY=your-secret-api-key

# 대표(canonical) 도메인. 실제 서비스 중인 프로덕션 호스트와 반드시 일치시킬 것 —
# metadata base·canonical·OG·sitemap·robots·RSS·JSON-LD가 모두 이 값을 기준으로 생성된다.
# (Vercel Preview/개발 환경에서는 비워두면 코드 기본값으로 폴백 — docs/SEO_ANALYTICS.md 참고)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# 자체 호스팅 IndexNow 예약 작업과 수동 제출 API. 각 값은 별도 32바이트 이상 난수로 설정.
# CRON_SECRET=...
# INDEXNOW_SECRET=...

# 뉴스레터의 기존 구독 해지 링크를 유지하려면 이전 배포에서 사용한 값을 그대로 옮긴다.
# UNSUBSCRIBE_TOKEN_SECRET=...

# 네이버 서치어드바이저 "HTML 태그" 소유 확인 코드. 콤마로 여러 개(PC/모바일 속성 등) 지정 가능.
# 값 자체는 페이지 소스에 공개되지만 배포(계정)마다 달라지므로 코드에 고정하지 않는다.
# 미설정 시 <meta name="naver-site-verification"> 태그를 아예 출력하지 않는다.
# NAVER_SITE_VERIFICATION=code1,code2
